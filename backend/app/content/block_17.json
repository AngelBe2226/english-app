              "Presente simple",
              "sujeto + verbo (+s)",
              "rutinas, hechos, horarios",
              "always, every day, usually"
            ],
            [
              "Presente continuo",
              "am/is/are + -ing",
              "acción ahora, plan futuro",
              "now, at the moment"
            ],
            [
              "Presente perfecto",
              "have/has + participio",
              "experiencia, resultado presente",
              "ever, just, already, yet"
            ],
            [
              "Pres. perfecto continuo",
              "have/has been + -ing",
              "duración hasta ahora",
              "for, since, all day"
            ],
            [
              "Pasado simple",
              "verbo+ed / irregular",
              "acción terminada en el pasado",
              "yesterday, ago, last week"
            ],
            [
              "Pasado continuo",
              "was/were + -ing",
              "acción en progreso pasada",
              "while, when"
            ],
            [
              "Pasado perfecto",
              "had + participio",
              "el pasado del pasado",
              "by the time, before, after"
            ],
