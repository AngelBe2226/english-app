# Copia este archivo como .env.local (en esta misma carpeta) y rellena los
# valores. .env.local NUNCA se sube a git: está en .gitignore.

# OpenAI (platform.openai.com → API keys). La suscripción de ChatGPT no sirve:
# la API se paga aparte con saldo en platform.openai.com → Billing.
OPENAI_API_KEY=

# Cloudflare R2 (dash.cloudflare.com → R2 → Manage API tokens → Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=english-app-audio

# Generación automática del audio del contenido nuevo (1 = activada)
AUDIO_AUTO=0
# Hasta qué fase generar en automático (1 lecciones · 2 palabras · 3 verbos · 4 verbos+ · 5 tablas)
AUDIO_PHASE=5
# Tope de caracteres por pasada automática (~300.000 ≈ 5 $)
AUDIO_MAX_CHARS_PER_RUN=300000
